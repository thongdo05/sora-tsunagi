[resource]
script = ExtResource("1_script")
world_id = "moonheld"
sky_color = Color(0.035, 0.09, 0.22, 1)
art_note = "Six-panel Moonheld chain, manifest run2_fix_v1. Sky plates are the far layer (panel 1 lighting matched to 2-6, rift interior purple, wisps and misted waterfalls in the sky). The alpha sea/wreck plates are the mid layer, with the painted deck feathered out from row 1104 to 1132 so it is not a floor. Stride 2304, overlap 512, full panel 2816. Near layer left empty so it does not stack a second sea on the chain."
far_panels = Array[Texture2D]([ExtResource("s1"), ExtResource("s2"), ExtResource("s3"), ExtResource("s4"), ExtResource("s5"), ExtResource("s6")])
mid_panels = Array[Texture2D]([ExtResource("m1"), ExtResource("m2"), ExtResource("m3"), ExtResource("m4"), ExtResource("m5"), ExtResource("m6")])
reuse_until = 4
chain_stride_px = 2304
chain_full_px = 2816
